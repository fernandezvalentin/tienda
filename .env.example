# Modo demo: con NEXT_PUBLIC_DEMO_MODE=1 (o sin URL de Supabase) la tienda usa datos de ejemplo
# en memoria y no necesita Supabase. Ideal para mostrarla en un portfolio.
# NEXT_PUBLIC_DEMO_MODE=1

# Copiá este archivo a .env.local y completá con los datos de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# URL pública del sitio (para links en emails, SEO, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave secreta de Supabase (Project Settings → API → secret / service_role).
# SOLO servidor. Necesaria para que el webhook de Mercado Pago marque pedidos como pagados.
SUPABASE_SECRET_KEY=

# Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app)
# Access token de producción o de prueba (TEST-...)
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones → Webhooks → "Clave secreta")
MP_WEBHOOK_SECRET=
